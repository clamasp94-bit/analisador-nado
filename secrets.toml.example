# ============================================================
# Credenciais de envio do relatório — NUNCA suba o arquivo real
# (local: .streamlit/secrets.toml | cloud: Settings → Secrets)
# ============================================================

# --- Opção A: SMTP (Gmail exige SENHA DE APP, não a senha normal) ---
# Gere em: myaccount.google.com/apppasswords (verificação em 2 etapas ativa)
[smtp]
host = "smtp.gmail.com"
port = 587            # 587 = STARTTLS | 465 = SSL (o app tenta as duas)
user = "seuemail@gmail.com"
password = "abcd efgh ijkl mnop"
remetente = "Analisador de Nado <seuemail@gmail.com>"

# Outlook/Office365: host = "smtp.office365.com", port = 587
# Yahoo:            host = "smtp.mail.yahoo.com", port = 465

# --- Opção B (fallback recomendado): API HTTPS — porta 443, nunca bloqueada ---
# Use QUANDO o host bloquear SMTP de saída (erro "Connection unexpectedly closed").
# Descomente UMA das opções abaixo:

# [email_api]
# provider = "resend"                      # resend | sendgrid | brevo
# api_key = "re_..."                       # chave da plataforma
# remetente = "Analisador de Nado <voce@seudominio.com>"
